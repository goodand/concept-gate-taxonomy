// referential ∃ 경계 순환 — Z1 (고리를 고리로 그린다 + 시도 4개 + 끊는 간선 1개)
// 렌더: mcp-kroki download_diagram(type="graphviz", content=<이 파일>)
// 이 파일이 소스 정본이다.
digraph L1 {
  rankdir=LR; bgcolor="white"; compound=true;
  node [fontname="Helvetica" shape=box style="rounded,filled" fontsize=11];
  edge [fontname="Helvetica" fontsize=9];
  subgraph cluster_cycle {
    label="고리 — 네 간선이 서로를 요구한다"; style=solid; color="#c00"; penwidth=2; fontsize=11; fontcolor="#c00";
    A [label="순수 measurand\nY_scope = f(scope 능력)" fillcolor="#ffd6d6"];
    B [label="scope 와 encoding 의\n분리" fillcolor="#ffd6d6"];
    C [label="referential ∃ 경계" fillcolor="#ffd6d6"];
    D [label="무엇이 정답인가\n(채점 계약)" fillcolor="#ffd6d6"];
    A -> B [label="필요하다"]; B -> C [label="필요하다"];
    C -> D [label="정한다"]; D -> A [label="정의한다" color="#c00" penwidth=2];
  }
  subgraph cluster_dead {
    label="시도했고 고리를 끊지 못한 것"; style=dashed; color="#888"; fontsize=10;
    e1 [label="synset 으로 경계\n(person.n.01 이 3부류)" fillcolor="#e8e8e8"];
    e2 [label="표면 목록으로 경계\n(4회 실패 · 비율 2~51%)" fillcolor="#e8e8e8"];
    e3 [label="FOLIO 규약 채택\n(D-34 기각)" fillcolor="#e8e8e8"];
    e4 [label="Name/ANA 를 권위로\n(D-35: 증거지 권위 아님)" fillcolor="#e8e8e8"];
  }
  cut [label="외부 권위\n(apparatus 밖에서\n의미 부류를 기록)" fillcolor="#d8f0d8" shape=box style="filled,bold" penwidth=2];
  neg [label="내 측정이 실제로 한 일\n= 거짓 탈출구 제거\n(주석 부재는 범위다: he 82/990)" fillcolor="#cfe3ff"];
  e1 -> C [style=dashed color="#888" label="식별 함수 아님"];
  e2 -> C [style=dashed color="#888" label="목록이 이미 경계"];
  e3 -> C [style=dashed color="#888" label="규약≠권위"];
  e4 -> C [style=dashed color="#888" label="증거≠충분조건"];
  cut -> C [label="유일하게 끊는다" color="#080" penwidth=2];
  neg -> e2 [label="이것이 탈출 아님을 보임" style=dotted];
  neg -> e4 [label="같음" style=dotted];
}
