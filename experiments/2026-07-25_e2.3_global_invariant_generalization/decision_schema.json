{
  "name": "client_decision_v5_e2.3_generalization",
  "description": "E2.3 tests generalization of E2.2.3's A factor (global feature-type consistency prompt rule) alone -- no schema minItems constraint is used in any arm this round (factor C was already found insufficient alone in E2.2.3). Schema is otherwise identical to E2.2.1/E2.2.3's no_minitems variant: repaired_concepts is an unconstrained-length array/null, features[].type carries the 6-value FeatureType enum.",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["decision", "repaired_concepts", "request", "report"],
    "properties": {
      "decision": {
        "type": "string",
        "enum": ["report_done", "repair", "request_evidence"]
      },
      "repaired_concepts": {
        "type": ["array", "null"],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "features"],
          "properties": {
            "name": {"type": "string"},
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["feature", "type", "evidence"],
                "properties": {
                  "feature": {"type": "string"},
                  "type": {
                    "type": "string",
                    "enum": [
                      "essential_feature",
                      "contextual_usage",
                      "locational",
                      "functional",
                      "social_treatment",
                      "structural_composition"
                    ]
                  },
                  "evidence": {"type": "string"}
                }
              }
            }
          }
        }
      },
      "request": {"type": ["string", "null"]},
      "report": {"type": "string"}
    }
  }
}
