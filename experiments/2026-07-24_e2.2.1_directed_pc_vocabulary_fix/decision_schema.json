{
  "name": "client_decision_v2_vocab_exposed",
  "description": "E2.2.1 patch over E2.2's client_decision schema: repaired_concepts[].features[].type is now an explicit enum covering all 6 FeatureType values (including structural_composition), instead of an unconstrained object. This is the ONLY change from E2.2's decision_schema.json.",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["decision", "repaired_concepts", "request", "report"],
    "properties": {
      "decision": {
        "type": "string",
        "enum": ["report_done", "repair", "request_evidence"]
      },
      "repaired_concepts": {
        "type": ["array", "null"],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "features"],
          "properties": {
            "name": {"type": "string"},
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["feature", "type", "evidence"],
                "properties": {
                  "feature": {"type": "string"},
                  "type": {
                    "type": "string",
                    "enum": [
                      "essential_feature",
                      "contextual_usage",
                      "locational",
                      "functional",
                      "social_treatment",
                      "structural_composition"
                    ]
                  },
                  "evidence": {"type": "string"}
                }
              }
            }
          }
        }
      },
      "request": {"type": ["string", "null"]},
      "report": {"type": "string"}
    }
  }
}
